# Jal Prahari works fully without AI. Leave everything below blank and the
# ranking, ghat details, Q&A bar and bilingual brief all use the built-in engine.
#
# To switch AI on later: copy this file to .env, pick a provider for each role,
# and add that provider's key. Providers: cerebras | anthropic
#   FAST_AI_PROVIDER    Q&A bar + per-ghat summaries (needs low latency)
#   WRITER_AI_PROVIDER  wording of the deployment brief, English + Hindi
FAST_AI_PROVIDER=
WRITER_AI_PROVIDER=

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-4-scout-17b-16e-instruct

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Date of the next Durga Visarjan (drives the countdown and the brief). Default 2026-10-20.
# VISARJAN_DATE=2027-10-09

# PORT=3000
# HOST=127.0.0.1    # set 0.0.0.0 to open it to other computers on the office network
